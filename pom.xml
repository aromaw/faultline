<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.branchdiff</groupId>
  <artifactId>branch-diff-tool</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>branch-diff-tool</name>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javaparser.version>3.28.2</javaparser.version>
    <junit.version>5.11.4</junit.version>
    <!-- identifies the build in the summary cache key (faultline-version.properties): a rebuilt jar never reads
         summaries an older build wrote -->
    <maven.build.timestamp.format>yyyyMMddHHmmss</maven.build.timestamp.format>
    <faultline.build.id>${maven.build.timestamp}</faultline.build.id>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.github.javaparser</groupId>
      <artifactId>javaparser-symbol-solver-core</artifactId>
      <version>${javaparser.version}</version>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>2.3</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.18.2</version>
    </dependency>
    <dependency>
      <!-- Myers line diff for the HTML report (Apache License 2.0) -->
      <groupId>io.github.java-diff-utils</groupId>
      <artifactId>java-diff-utils</artifactId>
      <version>4.12</version>
    </dependency>
    <dependency>
      <!-- GUI look and feel: IntelliJ light / Darcula themes (Apache License 2.0) -->
      <groupId>com.formdev</groupId>
      <artifactId>flatlaf</artifactId>
      <version>3.7.2</version>
    </dependency>
    <dependency>
      <!-- GUI code views with Java / XML syntax highlighting (BSD 3-Clause) -->
      <groupId>com.fifesoft</groupId>
      <artifactId>rsyntaxtextarea</artifactId>
      <version>3.6.3</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>branch-diff-tool</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <excludes><exclude>faultline-version.properties</exclude></excludes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes><include>faultline-version.properties</include></includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!-- tests never touch the user's ~/.faultline/cache -->
          <systemPropertyVariables>
            <faultline.cacheDir>${project.build.directory}/test-summary-cache</faultline.cacheDir>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.branchdiff.Main</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
                <filter>
                  <!-- the GUI highlights Java / XML / YAML / properties / SQL / web files only: drop the other
                       languages' token makers (~1.5 MB uncompressed) -->
                  <artifact>com.fifesoft:rsyntaxtextarea</artifact>
                  <excludes>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/ActionScriptTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/Assembler6502TokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/AssemblerX86TokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/BBCodeTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/CPlusPlusTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/CSharpTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/CTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/ClojureTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/CsvTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/DTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/DartTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/DelphiTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/DockerTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/DtdTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/FortranTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/GoTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/HandlebarsTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/HostsTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/HtaccessTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/IniTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/JSPTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/JshintrcTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/LatexTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/LessTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/LispTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/LuaTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/MakefileTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/MxmlTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/NSISTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/PHPTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/PerlTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/PowerShellTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/ProtoTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/PythonTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/RubyTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/RustTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/SASTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/ScalaTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/TclTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/TypeScriptTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/UnixShellTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/VhdlTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/VisualBasicTokenMaker*.class</exclude>
                    <exclude>org/fife/ui/rsyntaxtextarea/modes/WindowsBatchTokenMaker*.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
